# Copy this file to .env.local in the project root, then replace the placeholders.
# Never commit .env.local or share its secret values.

# Supabase Dashboard -> Project Settings -> API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only key (recommended: sb_secret_...). Legacy service_role key is also accepted.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Server-only HMAC secret. Generate a random value with at least 32 characters.
# `npm run setup:env` generates this value for you when it creates .env.local.
LOGIN_THROTTLE_SECRET=__GENERATE_RANDOM_SECRET__


# Legacy names accepted for existing Supabase projects:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
