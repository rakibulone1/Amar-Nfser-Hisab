{
  "name": "amar-nfser-hisab",
  "version": "1.2.3",
  "private": true,
  "description": "ব্যক্তিগত মুহাসাবা, আত্মশুদ্ধি ও উন্নয়নের ওয়েব অ্যাপ্লিকেশন",
  "scripts": {
    "dev": "next dev",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:env:reset": "node scripts/setup-env.mjs --reset",
    "env:check": "node scripts/env-doctor.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:phase02": "node --test tests/phase02-contract.test.mjs",
    "test:phase03": "node --test tests/phase03-contract.test.mjs",
    "test:phase04": "node --test tests/phase04-env-ui-contract.test.mjs",
    "test:frontend": "node --test tests/frontend-phase06.test.mjs",
    "test:all": "npm run test:phase02 && npm run test:phase03 && npm run test:phase04 && npm run test:phase05 && npm run test:phase06 && npm run test:phase07 && npm run test:phase08 && npm run test:phase08followup && npm run test:phase10 && npm run test:release-ui && npm run test:phase11 && npm run test:phase12 && npm run test:phase13 && npm test && npm run test:phase14 && npm run test:phase15",
    "test:phase05": "node --test tests/phase05-performance.test.mjs",
    "test:phase07": "node --test tests/phase07-contract.test.mjs",
    "test:phase06": "node --test tests/frontend-phase06.test.mjs",
    "test:phase08": "node --test tests/phase08-qa.test.mjs",
    "test:phase08followup": "node --test tests/phase08-followup.test.mjs",
    "test:phase09": "tsx --test tests/phase09-semi-final.test.ts",
    "test:phase10": "node --test tests/phase10-cloud-only.test.mjs",
    "test:release-ui": "node --test tests/release-ui-contract.test.mjs",
    "verify:release": "npm run test:all && npm run typecheck && npm run lint && npm run build",
    "test:phase11": "node --test tests/phase11-online-snapshot.test.mjs",
    "test:phase12": "node --test tests/phase12-release.test.mjs",
    "test:phase13": "node --test tests/phase13-release-hardening.test.mjs",
    "test:phase14": "node --test tests/phase14-server-snapshot-import.test.mjs",
    "test:phase15": "node --test tests/phase15-mobile-journey.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.89.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "postcss": "^8.5.6"
  },
  "engines": {
    "node": "22.x"
  },
  "verify:release": "npm run test:all && npm run typecheck && npm run lint && npm run build"
}
